# Fill locally outside the repository. No working credentials are provided.
FLASK_CONFIG=production
SECRET_KEY=
SQLALCHEMY_DATABASE_URI=
# mysql+pymysql://USER:URL_ENCODED_PASSWORD@HOST/USER$DATABASE?charset=utf8mb4
RATELIMIT_STORAGE_URI=
# rediss://USER:URL_ENCODED_PASSWORD@HOST:PORT/0
JWT_PRIVATE_KEY_FILE=/home/YOUR_USERNAME/.config/bar_pro/jwt-private.pem
JWT_PUBLIC_KEY_FILE=/home/YOUR_USERNAME/.config/bar_pro/jwt-public.pem
JWT_ISSUER=bar-manager-pro
JWT_AUDIENCE=bar-manager-pro-api
LOG_LEVEL=INFO

# Set 1 only behind an isolated, trusted local Nginx/Caddy reverse proxy.
TRUSTED_PROXY_PROTO_HOPS=0
# HTTPS responses only, no includeSubDomains or preload.
HSTS_MAX_AGE=86400
