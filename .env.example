# Copy this file to .env for local development. Do not commit .env.
# Generate a unique value locally, for example:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Development may use SQLite locally. Production must use a mysql+pymysql URI.
SQLALCHEMY_DATABASE_URI=sqlite:///bar_manager_pro_dev.sqlite3
TEST_DATABASE_URI=sqlite+pysqlite:///:memory:

# Flask environment selection: development, testing, production.
FLASK_CONFIG=development

# Production must use a durable shared store, such as Redis.
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://

# Production log level. Do not put database credentials, tokens, or secrets in logs.
LOG_LEVEL=INFO

# ES256 PEM keys, generated outside this repository. Required for API authentication.
JWT_PRIVATE_KEY_FILE=
JWT_PUBLIC_KEY_FILE=
JWT_ISSUER=bar-manager-pro
JWT_AUDIENCE=bar-manager-pro-api
